@echo off
REM HealthSpire HMS - Desktop App Installer (Windows)
REM Server URL: https://sialkotmedical.healthspire.org

set "APPDIR=%LocalAppData%\HealthSpireHMS"
set "LAUNCHER=%APPDIR%\launch-healthspire.ps1"
set "ICONPATH=%APPDIR%\healthspire-icon.ico"
set "SHORTCUT=%USERPROFILE%\Desktop\HealthSpire HMS.lnk"

mkdir "%APPDIR%" 2>nul

echo Writing launcher script...
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -Command "[System.IO.File]::WriteAllText('%LAUNCHER%', [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String('')), [System.Text.Encoding]::UTF8)"

echo Downloading icon...
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -Command "try { Invoke-WebRequest -Uri 'https://sialkotmedical.healthspire.org/hospital_icon.ico' -OutFile '%ICONPATH%' -UseBasicParsing -TimeoutSec 5 } catch { Copy-Item '%SystemRoot%\System32\shell32.dll' '%ICONPATH%' -ErrorAction SilentlyContinue }"

echo Creating desktop shortcut...
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -Command "$ws = New-Object -ComObject WScript.Shell; $sc = $ws.CreateShortcut('%SHORTCUT%'); $sc.TargetPath = '%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe'; $sc.Arguments = '-NoProfile -ExecutionPolicy Bypass -File "%LAUNCHER%"'; $sc.IconLocation = '%ICONPATH%'; $sc.WorkingDirectory = '%APPDIR%'; $sc.Description = 'HealthSpire HMS - Hospital Management System'; $sc.Save()"

echo.
echo  ============================================
echo   HealthSpire HMS Desktop App Installed!
echo  ============================================
echo.
echo  A shortcut has been created on your Desktop.
echo  Double-click "HealthSpire HMS" to launch the app.
echo.
echo  Server URL: https://sialkotmedical.healthspire.org
echo.
echo  Note: If the app doesn't open, check the log at:
echo  %APPDIR%\launcher.log
echo.
pause
