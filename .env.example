# Frontend (Vite) — copy to .env / .env.production as needed
VITE_API_BASE=http://localhost:5000
# Optional: Google Maps JavaScript API key for Rider Live Map
VITE_GOOGLE_MAPS_API_KEY=

# Server
PORT=5000
MONGO_URI=mongodb://localhost:27017/
DB_NAME=restaurant_pos
# Same Maps key can be served via /api/client-config (no rebuild needed if only set on server)
GOOGLE_MAPS_API_KEY=
PUBLIC_API_BASE=
JWT_SECRET=change_me_in_production
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=